# Servidor
APP_HOST=0.0.0.0
APP_PORT=8000

# Banco (Postgres + pgvector via docker-compose)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/agent_service

# Modelo padrão (Gemini)
DEFAULT_MODEL_PROVIDER=google
DEFAULT_MODEL_ID=gemini-2.5-flash
GOOGLE_API_KEY=

# Cifra em repouso das chaves de provedor de modelo cadastradas pelo console
# (/model-providers). Sem isto, salvar/ler uma chave falha alto — nunca cai
# pra texto plano. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Mem0 (opcional, fase 2)
MEM0_ENABLED=false
MEM0_API_KEY=

# Tools kind="python" (ver README, seção "Tools dos agentes") — desligado por
# padrão: roda num namespace restrito, mas NÃO é uma sandbox forte. Só ligue
# se quem tem acesso à API/console já for confiável.
# Teto do texto de entrada (message do /chat, document do /analyze), em
# caracteres. Acima disso a requisição volta 422 em vez de o texto seguir
# inteiro para o modelo e estourar contexto com um erro obscuro do provedor.
# Chaves de API do serviço. Sem as duas, QUALQUER um que alcance a porta lê as
# conversas (/observability/runs, /sessions), reescreve prompts (PUT /agents/x)
# e lê as credenciais de modelo. Obrigatórias fora da sua máquina.
#   ADMIN_API_KEY   -> console e CLI (KURO_API_KEY): acesso total
#   RUNTIME_API_KEY -> outros módulos: só /chat, /chat/stream, /analyze e scores
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotação sem derrubar ninguém: `nova,antiga` (vírgula) vale as duas; a primeira é a
# atual. Depois que os clientes trocarem, deixe só a nova. Ver docs/operacao.md.
ADMIN_API_KEY=
RUNTIME_API_KEY=

# Páginas (no navegador, em outro domínio) que podem ler as respostas da API. O console
# não precisa: ele chama a API pelo servidor. Vazio = a lista do AgentOS (localhost:3000
# e os domínios do Agno, para o playground); `none` = nenhuma; ou a lista, por vírgula.
# `*` não vale. A chave de API continua exigida de qualquer jeito.
CORS_ORIGINS=

# TLS (profile `tls`). A chave de API viaja num header: em HTTP puro ela vai em
# texto claro no fio, junto com as mensagens do cliente. Com um domínio público
# apontando para esta máquina e as portas 80/443 abertas, o Caddy emite o
# certificado pelo Let's Encrypt e renova sozinho.
#   docker compose --profile tls up -d
# Deixe em `localhost` para testar a configuração sem domínio (certificado interno).
KURO_API_DOMAIN=localhost
KURO_CONSOLE_DOMAIN=console.localhost
KURO_TLS_EMAIL=

# HTTPS pelo IP, sem domínio (profile `ip`): `docker compose --profile ip up -d`.
# CA própria do Caddy na porta 58443, sem precisar de 80/443. O IP público é
# descoberto sozinho; defina aqui só para fixar ou trocar a porta.
#KURO_PUBLIC_IP=
#KURO_IP_PORT=58443

# O endereço do serviço visto de fora, quando nenhum dos dois acima diz (ex.: atrás
# de um proxy que já existe). Vai nos exemplos do contrato de integração e no
# `kuro mcp-config`. Sem domínio próprio: KURO_API_DOMAIN=<ip-com-hífens>.sslip.io.
#KURO_PUBLIC_URL=https://kuro.empresa.com

MAX_INPUT_CHARS=200000

CUSTOM_PYTHON_TOOLS_ENABLED=false

# Para onde as tools podem falar. Vazio = só endereços públicos: uma tool não
# alcança o Postgres, o Redis nem o metadata da nuvem a partir do container.
# Libere aqui, por host, os serviços internos que suas tools precisam chamar.
TOOL_EGRESS_ALLOWLIST=

# Chaves de metadata que ligam runs de um fluxo (ex.: o ciclo do moderador:
# triagem → redação). A tela do run mostra os irmãos em ordem. Vazio desliga.
# CORRELATION_METADATA_KEYS=ciclo_id

# Onde `kuro runs` e /observability/* leem as execuções: db (padrão, o próprio
# Postgres, sem Langfuse) ou langfuse (exige o Langfuse ligado).
TRACE_STORE_BACKEND=db

# Tempo limite padrão de uma execução (504 ao estourar) e execuções simultâneas
# por processo (acima disso, 503 com Retry-After — não há fila no Kuro).
RUN_TIMEOUT_SECONDS=90

# Modelo das tarefas de apoio (extrair memória de longo prazo, resumir a sessão).
# Vazio = o modelo do próprio agente; um modelo barato corta o custo dessas chamadas.
# AUX_MODEL_ID=gemini-flash-lite-latest
# Quantas memórias de longo prazo (as mais recentes) entram no prompt.
MEMORY_CONTEXT_LIMIT=10
MAX_CONCURRENT_RUNS=16
# Fila de espera acima do limite: tamanho e espera máxima (0 = sem fila, 503 na hora).
QUEUE_MAX_SIZE=64
QUEUE_MAX_WAIT_SECONDS=30

# Fila de jobs no Postgres (sincronização de sites; ver docs/operacao.md#fila-de-jobs).
# JOBS_ENABLED=false numa réplica que só deve enfileirar.
JOBS_ENABLED=true
JOBS_CONCURRENCY=2
JOBS_POLL_SECONDS=5
JOBS_LEASE_SECONDS=60
JOBS_MAX_ATTEMPTS=3
JOBS_BACKOFF_SECONDS=30
JOBS_LISTEN=true
# Por quanto tempo um header Idempotency-Key no /chat e no /analyze devolve a resposta
# guardada em vez de rodar de novo (docs/integracao.md).
IDEMPOTENCY_TTL_HOURS=24

# Preço por modelo (USD por 1M de tokens de entrada/saída) para o custo estimado
# das execuções — sobrescreve a tabela de src/agent_service/models/pricing.py.
# MODEL_PRICES={"gemini-2.5-flash": [0.30, 2.50]}

# Langfuse (observabilidade: traces, custo, sessões, feedback)
# O docker-compose sobe um Langfuse self-hosted em http://localhost:3100 e
# provisiona no primeiro boot o projeto "agent-service" com estas chaves e este
# usuário. Valores de dev — troque fora da máquina local. Para o Langfuse Cloud,
# use as chaves do seu projeto e LANGFUSE_BASE_URL=https://cloud.langfuse.com.
# Desligado por padrão (mesmo default do config.py e do docker-compose.yml).
# Ligue junto com o profile: `LANGFUSE_ENABLED=true docker compose --profile observability up -d`.
# Ligado com o Langfuse fora do ar, cada run paga LANGFUSE_TIMEOUT_SECONDS tentando exportar.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-local-agent-service
LANGFUSE_SECRET_KEY=sk-lf-local-agent-service
LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_PROJECT_ID=agent-service
LANGFUSE_ENVIRONMENT=development
# Timeout do envio de traces (o default de 5s do SDK descarta lotes se o Langfuse demorar)
LANGFUSE_TIMEOUT_SECONDS=20
LANGFUSE_INIT_USER_EMAIL=admin@agent-service.local
LANGFUSE_INIT_USER_PASSWORD=agent-service-admin
